bool   n1000   = input.bool(true, "خبر ساعت ۱۰:۰۰ نیویورک (۱۸:۳۰ تهران در زمستان)", group = GT)
bool   n1400   = input.bool(false, "خبر ساعت ۱۴:۰۰ نیویورک، فدرال رزرو (۲۲:۳۰ تهران در زمستان)", group = GT)
