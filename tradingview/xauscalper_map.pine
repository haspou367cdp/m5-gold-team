float  feedSpr = input.float(0.35, "اسپرد معمول فید چارت (دلار)", minval = 0, step = 0.05, tooltip = "فقط برای تبدیل bid به میانه به کار می‌رود (همان ۰٫۳۵ پیش‌فرض بات).", group = GP)
float  lvlOff  = input.float(0.30, "اختلاف سطح‌ها با bid (دلار)", step = 0.01, tooltip = "سطح‌ها مثل بات به قیمت دریاگلد = bid + این عدد نشان داده می‌شوند (پیش‌فرض ۰٫۳۰، همان عدد بات). اگر با /offset در بات عدد دیگری ثبت کرده‌اید، همان را اینجا هم بگذارید.", group = GP)
float  midOff  = input.float(0.02, "اختلاف قیمت زنده‌ی دریاگلد با قیمت میانه (دلار)", step = 0.01, tooltip = "بات قیمت زنده‌ی دریاگلد را قیمت میانه به‌اضافه‌ی این عدد می‌گیرد (پیش‌فرض ۰٫۰۲). ستاپ‌ها، فاصله تا ورود و پر شدن سفارش با این قیمت حساب می‌شوند.", group = GP)
