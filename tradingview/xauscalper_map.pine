// ───────────────────────── ثابت‌ها ─────────────────────────
const string TZT = "Asia/Tehran"
const string TZN = "America/New_York"
const string TZL = "Europe/London"
const int    MIN = 60000
const int    HOUR = 3600000
const int    DAY = 86400000
const int    EVAL_N = 100          // bars (from the right edge) where levels, trend and setups are evaluated
bool  phone = mode == "گوشی"
float units = unitT == "یک واحد" ? 1.0 : 0.5
float tpu   = tpu1 * units
f_size() => txtSz == "کوچک" ? size.small : txtSz == "بزرگ" ? size.large : size.normal

// ───────────────────────── ساخت کندل‌های ۵ و ۱۵ دقیقه و ۱ و ۴ ساعت از روی چارت ─────────────────────────
// Clock buckets in UTC, like pandas resample("5min"/"15min"/"1h"/"4h", label=left, closed=left) in fetch_xauusd.py.
// The forming bucket is the last element (the bot also includes the forming bar).
// st = [ema20 (closed bars), ema50 (closed), ATR14 Wilder (closed), previous close, closed-bar count]
f_upd(array<int> t, array<float> h, array<float> l, array<float> c, array<float> st, int ms, int cap) =>
    int b = int(math.floor(time / ms)) * ms
    int n = t.size()
    if n == 0 or t.get(n - 1) != b
        if n > 0
            float cp = c.get(n - 1)
            float hp = h.get(n - 1)
            float lp = l.get(n - 1)
            float e20 = st.get(0)
            float e50 = st.get(1)
            float a = st.get(2)
            float pc = st.get(3)
            float tr = na(pc) ? hp - lp : math.max(hp - lp, math.abs(hp - pc), math.abs(lp - pc))
            st.set(0, na(e20) ? cp : e20 + (cp - e20) * 2.0 / 21.0)
            st.set(1, na(e50) ? cp : e50 + (cp - e50) * 2.0 / 51.0)
            st.set(2, na(a) ? tr : a + (tr - a) / 14.0)
            st.set(3, cp)
            st.set(4, st.get(4) + 1)
        t.push(b)
        h.push(high)
        l.push(low)
        c.push(close)
        if t.size() > cap
            t.shift()
            h.shift()
            l.shift()
            c.shift()
    else
        h.set(n - 1, math.max(h.get(n - 1), high))
        l.set(n - 1, math.min(l.get(n - 1), low))
        c.set(n - 1, close)
    0

// values including the forming bar
f_cur(array<float> h, array<float> l, array<float> c, array<float> st) =>
    int n = c.size()
    float cp = n > 0 ? c.get(n - 1) : na
    float e20 = st.get(0)
    float e50 = st.get(1)
    float a = st.get(2)
    float pc = st.get(3)
    float tr = n == 0 ? na : na(pc) ? h.get(n - 1) - l.get(n - 1) : math.max(h.get(n - 1) - l.get(n - 1), math.abs(h.get(n - 1) - pc), math.abs(l.get(n - 1) - pc))
    float e20c = na(e20) ? cp : e20 + (cp - e20) * 2.0 / 21.0
    float e50c = na(e50) ? cp : e50 + (cp - e50) * 2.0 / 51.0
    float ac = na(a) ? tr : a + (tr - a) / 14.0
    [e20c, e50c, ac, st.get(4) + 1]

var array<int>   t5 = array.new<int>()
var array<float> h5 = array.new<float>()
var array<float> l5 = array.new<float>()
var array<float> c5 = array.new<float>()
var array<float> s5 = array.from(float(na), float(na), float(na), float(na), 0.0)
var array<int>   t15 = array.new<int>()
var array<float> h15 = array.new<float>()
var array<float> l15 = array.new<float>()
var array<float> c15 = array.new<float>()
var array<float> s15 = array.from(float(na), float(na), float(na), float(na), 0.0)
var array<int>   t60 = array.new<int>()
var array<float> h60 = array.new<float>()
var array<float> l60 = array.new<float>()
var array<float> c60 = array.new<float>()
var array<float> s60 = array.from(float(na), float(na), float(na), float(na), 0.0)
var array<int>   t240 = array.new<int>()
var array<float> h240 = array.new<float>()
var array<float> l240 = array.new<float>()
var array<float> c240 = array.new<float>()
var array<float> s240 = array.from(float(na), float(na), float(na), float(na), 0.0)
f_upd(t5, h5, l5, c5, s5, 5 * MIN, 320)
f_upd(t15, h15, l15, c15, s15, 15 * MIN, 320)
f_upd(t60, h60, l60, c60, s60, HOUR, 220)
f_upd(t240, h240, l240, c240, s240, 4 * HOUR, 140)

// ───────────────────────── روز، هفته، ماه و دامنه‌ی روزانه ─────────────────────────
// Gold trading day = 18:00 → 17:00 New York; week = Sunday 18:00 New York; month = New York calendar month.
int  tdKey   = dayofmonth(time + 6 * HOUR, TZN)
int  wkKey   = weekofyear(time + 6 * HOUR, TZN)
bool newTD   = bar_index > 0 and tdKey != tdKey[1]
bool newWk   = bar_index > 0 and (wkKey != wkKey[1] or time - time[1] > 3 * DAY)
var float tdH = na
var float tdL = na
var array<float> dayH = array.new<float>()   // completed trading days, newest last
var array<float> dayL = array.new<float>()
if newTD
    if not na(tdH)
        dayH.push(tdH)
        dayL.push(tdL)
        if dayH.size() > 21
            dayH.shift()
            dayL.shift()
    tdH := high
    tdL := low
else
    tdH := na(tdH) ? high : math.max(tdH, high)
    tdL := na(tdL) ? low : math.min(tdL, low)
var float wkH = na
var float wkL = na
var float pwH = na
var float pwL = na
if newWk
    if not na(wkH)
        pwH := wkH
        pwL := wkL
    wkH := high
    wkL := low
else
    wkH := na(wkH) ? high : math.max(wkH, high)
    wkL := na(wkL) ? low : math.min(wkL, low)
// Month = New York calendar month, tracked on the chart. When the chart history does not reach back to the month start
// (free plan ≈ 5000 bars), the monthly series is used instead ([1] = completed month, no repaint).
int  moKey = month(time, TZN)
bool newMo = bar_index > 0 and moKey != moKey[1]
var int   moSeen = 0
var float mHl = na
var float mLl = na
var float pmHl = na
var float pmLl = na
if newMo
    moSeen += 1
    pmHl := mHl
    pmLl := mLl
    mHl := high
    mLl := low
else
    mHl := na(mHl) ? high : math.max(mHl, high)
    mLl := na(mLl) ? low : math.min(mLl, low)
[pmHs, pmLs, mHs, mLs] = request.security(syminfo.tickerid, "1M", [high[1], low[1], high, low], lookahead = barmerge.lookahead_on)
float mH  = moSeen >= 1 ? mHl : mHs
float mL  = moSeen >= 1 ? mLl : mLs
float pmH = moSeen >= 2 ? pmHl : pmHs
float pmL = moSeen >= 2 ? pmLl : pmLs
// ADR = mean range of the 20 previous trading days (chart days when 20 are loaded, otherwise the daily series)
float adrS = request.security(syminfo.tickerid, "D", ta.sma(high - low, 20)[1], lookahead = barmerge.lookahead_on)
f_adr() =>
    float r = na
    int n = dayH.size()
    if n >= 20
        float sm = 0.0
        for i = n - 20 to n - 1
            sm += dayH.get(i) - dayL.get(i)
        r := sm / 20
    r
float adrL = f_adr()
float adr  = na(adrL) ? adrS : adrL
float adrUsed = na(adr) or adr == 0 ? na : (tdH - tdL) / adr * 100

// ───────────────────────── سشن‌ها ─────────────────────────
// Sessions of the UTC date (m5lib.sessions_for): Asia 00:00 UTC → 07:00 London, London 07:00 London → 08:30 NY, NY 08:30 → 17:00 NY.
int  utcKey = dayofmonth(time, "UTC")
bool newUtc = bar_index > 0 and utcKey != utcKey[1]
int  lonMin = hour(time, TZL) * 60 + minute(time, TZL)
int  nyMin  = hour(time, TZN) * 60 + minute(time, TZN)
bool inAsia = hour(time, "UTC") < 12 and lonMin < 420
bool inLon  = lonMin >= 420 and nyMin < 510
bool inLOR  = lonMin >= 420 and lonMin < 450
bool inNY   = nyMin >= 510 and nyMin < 1020
bool inNOR  = nyMin >= 510 and nyMin < 540
var float asH = na
var float asL = na
var float lnH = na
var float lnL = na
var float loH = na
var float loL = na
var float nyH = na
var float nyL = na
var float noH = na
var float noL = na
var float pnH = na
var float pnL = na
if newUtc
    if not na(nyH)
        pnH := nyH
        pnL := nyL
    asH := na
    asL := na
    lnH := na
    lnL := na
    loH := na
    loL := na
    nyH := na
    nyL := na
    noH := na
    noL := na
if inAsia
    asH := na(asH) ? high : math.max(asH, high)
    asL := na(asL) ? low : math.min(asL, low)
if inLon
    lnH := na(lnH) ? high : math.max(lnH, high)
    lnL := na(lnL) ? low : math.min(lnL, low)
if inLOR
    loH := na(loH) ? high : math.max(loH, high)
    loL := na(loL) ? low : math.min(loL, low)
if inNY
    nyH := na(nyH) ? high : math.max(nyH, high)
    nyL := na(nyL) ? low : math.min(nyL, low)
if inNOR
    noH := na(noH) ? high : math.max(noH, high)
    noL := na(noL) ? low : math.min(noL, low)

// VWAPs (chart volume; the bot uses Dukascopy tick volume) — day VWAP ±1σ and session VWAPs
[vwD, vwU, vwL] = ta.vwap(hlc3, newTD, 1)
var float asPV = 0.0
var float asV = 0.0
var float lnPV = 0.0
var float lnV = 0.0
var float nyPV = 0.0
var float nyV = 0.0
float vv = nz(volume) > 0 ? volume : 1e-9
if newUtc
    asPV := 0.0
    asV := 0.0
    lnPV := 0.0
    lnV := 0.0
    nyPV := 0.0
    nyV := 0.0
if inAsia
    asPV += hlc3 * vv
    asV += vv
if inLon
    lnPV += hlc3 * vv
    lnV += vv
if inNY
    nyPV += hlc3 * vv
    nyV += vv

// ───────────────────────── ساعت کار دریاگلد و خبرها ─────────────────────────
f_clock(int t) =>
    int dow = dayofweek(t, TZT)
    int hm  = hour(t, TZT) * 100 + minute(t, TZT)
    bool isWk     = dow >= dayofweek.monday and dow <= dayofweek.friday
    bool afterMid = dow >= dayofweek.tuesday and dow <= dayofweek.saturday and hm < closeHM
    bool open_    = (isWk and hm >= openHM) or afterMid
    bool friCut   = (dow == dayofweek.friday and hm >= friHM) or (dow == dayofweek.saturday and hm < closeHM)
    int  hmMin    = int(math.floor(hm / 100)) * 60 + hm % 100
    int  clMin    = int(math.floor(closeHM / 100)) * 60 + closeHM % 100
    int  frMin    = int(math.floor(friHM / 100)) * 60 + friHM % 100
    // minutes until the daily close (00:30) or, on Friday, until the no-new-entry time
    int  toClose  = afterMid ? clMin - hmMin : 1440 - hmMin + clMin
    int  toFri    = dow == dayofweek.friday and hm < friHM ? frMin - hmMin : 9999
    bool soon     = open_ and (math.min(toClose, toFri) <= soonMin)
    int  ndow = dayofweek(t, TZN)
    int  nm   = hour(t, TZN) * 60 + minute(t, TZN)
    bool nwk  = ndow >= dayofweek.monday and ndow <= dayofweek.friday
    bool news = nwk and ((n830 and nm >= 510 - nPre and nm < 510 + nPost) or (n1000 and nm >= 600 - nPre and nm < 600 + nPost) or (n1400 and nm >= 840 - nPre and nm < 840 + nPost))
    [open_, friCut, soon, news]

