float  sprd    = input.float(0.25, "حاشیه‌ی اسپرد (دلار)", minval = 0, step = 0.05, tooltip = "مثل بات: خرید با قیمت خرید (ask) پر می‌شود، پس بازه‌ی ورود خرید و حد ضرر و حد سود فروش به همین اندازه بالاتر گذاشته می‌شوند.", group = GP)
